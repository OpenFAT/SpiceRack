# Spectre: physical lines -> logical lines -> the AST (src/import/mod.rs
# `Tag`). Sources: dev/research/spectre-syntax.md (§ numbers; UG = Spectre
# User Guide 5.1.41, R19 = Spectre Reference 19.1), ESPice
# tests/frontend/grammar/spectre_lines.peg and spectre.peg. Spectre keeps
# case (§2.1): the cards stage reads the text as written.

# ── Lines ──
# Captures: Title; Line, a statement, made of Piece (joined with a blank);
# Line_spice, a statement in a `simulator lang=spice` region, made of
# Piece_spice and Glue_spice under HSPICE's line rules.

file       <- Title (l_eol l_body)? !.
# §1.2: line 1 of the top-level netlist is the title (UG p.29, p.50).
Title      <- (!l_eol .)*
l_body     <- (l_spice_region / Line / l_skip)*

# §3.1: `simulator lang=spice` holds until `simulator lang=spectre`, which a
# SPICE region writes without a dot (UG p.53).
l_spice_region <- &l_to_spice Line (!l_to_spectre (Line_spice / l_hskip))* l_spice_back?
l_spice_back <- &l_to_spectre Line_spice
l_to_spice <- l_blank* 'simulator' l_blank+ 'lang' l_blank* '=' l_blank* 'spice' !l_wchar
l_to_spectre <- l_blank* 'simulator'i l_blank+ 'lang'i l_blank* '=' l_blank* 'spectre'i !l_wchar

# §1.3: `*` in the first column comments the line (UG p.59); so does a
# line holding only a `//` comment. Blank lines are skipped.
l_skip     <- '*' (!l_eol .)* l_eolx
            / l_blank* '//' (!l_eol .)* l_eolx
            / l_blank* l_eol
            / l_blank+ !.

Line       <- ![*] l_blank* !'+' !'//' !l_eolx Piece l_comment? l_more* l_eolx
# §1.4: a backslash ending the line joins the next one (UG p.59), and so
# does `+` starting the next line.
l_more     <- l_bs_break Piece l_comment?
            / l_eol l_skip_cont* l_blank* '+' Piece l_comment?
l_bs_break <- '\\' l_blank* l_eolx
l_skip_cont <- '*' (!l_eol .)* l_eol / l_blank* '//' (!l_eol .)* l_eol / l_blank* l_eol

Piece      <- l_chunk*
l_chunk    <- l_string / l_escape / !'//' !l_bs_end !l_eol .
# §2.2: a backslash before any other byte is part of a name (`\2N2222`).
l_escape   <- !l_bs_end '\\' ![\r\n] .
l_bs_end   <- '\\' l_blank* l_eolx
# §1.3: `//` to the end of the line, outside strings.
l_comment  <- '//' (!l_eol .)*
# §2.5: double-quoted strings, a backslash escaping a quote.
l_string   <- '"' (!l_bs_end ('\\' !l_eol . / !'"' !l_eol .))* ('"' / &(l_bs_end / l_eolx))

# §3.2: a SPICE region reads as HSPICE does (hspice.peg L2-L6).
Line_spice <- l_blank* ![+*$] Piece_spice l_hmore* l_hcomment? l_eolx
l_hmore    <- l_blank* '\\\\' l_blank* l_eolx l_blank* Glue_spice
            / l_blank+ '\\' l_blank* l_eolx Piece_spice
            / l_hcomment? l_eol l_hskip* l_blank* '+' Piece_spice?
l_hskip    <- l_blank* [*$] (!l_eol .)* l_eolx / l_blank* l_eol / l_blank+ !.
Piece_spice <- l_hchunk+
Glue_spice <- l_hchunk*
l_hchunk   <- l_hquoted / l_hsep / l_hnum / l_hword
l_hsep     <- l_blank+ !('\\' l_blank* l_eolx) !('\\\\' l_blank* l_eolx) / [,=()]
l_hnum     <- [+\-]? ([0-9]+ ('.' [0-9]*)? / '.' [0-9]+) ([eEdD] [+\-]? [0-9]+)? [a-zA-Z]* &'$'
l_hword    <- !'$' !('\\\\' l_blank* l_eolx) l_hwchar (!('\\\\' l_blank* l_eolx) l_hwchar)*
l_hwchar   <- ![ \t,=()'"\r\n] .
l_hcomment <- '$' (!l_eol .)*
l_hquoted  <- "'" (!"'" !l_eol .)* "'" / '"' (!'"' !l_eol .)* '"'

l_wchar    <- [a-zA-Z0-9_!]
l_blank    <- [ \t]
l_eol      <- '\r'? '\n'
l_eolx     <- l_eol / !.

# ── Statements ──
deck       <- card* !.
card       <- (SpiceRegion / Subckt / Block / stmt) (nl / !.) / Unparsed nl
Unparsed   <- rest

# §3.1: a `simulator lang=spice` region, up to `simulator lang=spectre`:
# its `.meas` cards are the testbench's (codegen::spectre puts them there),
# the rest is SPICE text the IR has no Spectre form for.
SpiceRegion <- 'simulator' s 'lang' s? '=' s? 'spice' (s Pair)* (nl !to_spectre (Meas / Raw_spice))*
Meas       <- '.meas' 'ure'? !wchar rest
Raw_spice  <- rest
to_spectre <- 'simulator' s 'lang' s? '=' s? 'spectre'

stmt       <- simulator &nl / Include &nl / Load &nl / Global &nl / Params &nl / Model &nl
            / Func &nl / Save &nl / Ic &nl / Nodeset &nl / named &nl

# §3.1: back to Spectre, `insensitive=yes` optional (UG p.50).
simulator  <- 'simulator' s 'lang' s? '=' s? 'spectre' rest

# §3.3, §3.5: `include "file" [section=name]`, `ahdl_include "file"`.
Include    <- 'include' s Path (s 'section' s? '=' s? Section)?
Path       <- Str
Section    <- Name
Load       <- 'ahdl_include' s Path

# Blocks no IR field holds, kept whole: `library` / `section` (§3.4), a
# model group (UG p.108), `if` (R19 p.491), `statistics` (§4.13), and an
# analysis or control statement with children.
Block      <- 'library' s Name nl lines 'endlibrary' (s Name)?
            / 'section' s Name nl lines 'endsection' (s Name)?
            / 'model' s Name s Name (s param)* s? '{' nl lines '}'
            / 'if' s? '(' s? expr s? ')' (s / nl &'{') branch (s 'else' s (Block / branch))?
            / 'statistics' s? '{' nl lines '}'
            / Name s? (nodelist s?)? Name !wchar (s param)* s? '{' nl lines '}'
branch     <- '{' nl lines '}' / (!nl .)+
lines      <- (!(s? '}') !blockend (Block / nested / (!nl .)*) nl)*
# A line opening its own braces inside a block (`process {`).
nested     <- (!nl !'{' .)+ '{' s? nl lines s? '}' rest
blockend   <- ('endsection' / 'endlibrary') !wchar

# §4.8: `global 0 vdd!`: the first name is ground (R5 p.871), not a node.
Global     <- 'global' (s ('0' !wchar / Node))*

# §4.6: `parameters a=1 b=a*2`; a subcircuit's may omit a default (R19
# p.506), which the IR does not hold.
Params     <- 'parameters' (s (Assign / Flag))+
Assign     <- Key s? '=' s? Val
Flag       <- Key

# §4.4: `model name master [params]`.
Model      <- 'model' s Name s Word (s param)*

# §4.5: `[inline] subckt name [(]ports[)]` ... `ends [name]` (UG p.94).
Subckt     <- ('inline' s)? 'subckt' s Name ports? nl (!ends card)* (Ends / !.)
ports      <- s? '(' s? (Port (s Port)*)? s? ')' / (s Port)+
Port       <- node
ends       <- 'ends' !wchar
Ends       <- ends (s Name)?

# §4.7: `real f(real a, real b) { return expr }` (UG p.92), on one line or
# with the body on the lines after the `{`.
Func       <- 'real' s Name s? '(' s? (fargs)? s? ')' s? '{' (s fbody s '}' / nl fbody nl '}')
fargs      <- 'real' s Arg (s? ',' s? 'real' s Arg)*
Arg        <- Name
fbody      <- 'return' s Body (s? ';')?
Body       <- expr

# §4.11: `save X[:t] ...`, `ic sig=v ...`, `nodeset sig=v ...` (R11 p.366).
Save       <- 'save' (s Out)*
Out        <- signal
Ic         <- 'ic' (s NodeVal)+
Nodeset    <- 'nodeset' (s NodeVal)+
NodeVal    <- Node s? '=' s? Val
signal     <- node (':' (Name / [0-9]+))? / ':' Name

# §4.1: a statement led by a name: an analysis or a control statement when
# its type keyword follows the name (and an analysis's optional node list),
# an instance otherwise.
named      <- !(blockword !wchar) (Ana / Ctl / Inst)
blockword  <- 'endsection' / 'endlibrary' / 'ends' / 'else'

# §4.9: `name [(nodes)] type params` (UG p.66).
Ana        <- Name s? (nodelist s?)? Word_kind !wchar (s param)*
Word_kind  <- 'montecarlo' / 'acmatch' / 'dcmatch' / 'hbnoise' / 'qpnoise' / 'fourier' / 'pdisto'
            / 'pnoise' / 'hbstb' / 'envlp' / 'hbsp' / 'hbac' / 'hbxf' / 'noise' / 'qpac' / 'qpsp'
            / 'qpss' / 'qpxf' / 'sweep' / 'pac' / 'psp' / 'pss' / 'pstb' / 'pxf' / 'sens' / 'tran'
            / 'tdr' / 'stb' / 'ac' / 'dc' / 'hb' / 'pz' / 'sp' / 'xf'

# §4.10: `name type params`.
Ctl        <- Name s Word_ctl !wchar (s param)*
Word_ctl   <- 'altergroup' / 'checklimit' / 'paramtest' / 'paramset' / 'options' / 'assert'
            / 'alter' / 'check' / 'shell' / 'info' / 'set'

# §4.2: `name [(]nodes[)] master params`; without parentheses the master is
# the last bare word before the first `name=` (gnucap, NetlistParse.rs).
Inst       <- Name s? nodelist s? Mname (s param)*
            / Name (s Node &(s word))* s Mname (s param)*
Mname      <- Name
word       <- node !(s? '=')
nodelist   <- '(' s? (Node (s Node)*)? s? ')'

param      <- '(' s? Pair s? ')' / Pair
Pair       <- Key s? '=' s? Val
Val        <- vector / expr
# §5: vectors, blank-separated (R19: "not mandatory", UG p.208 shows commas).
vector     <- '[' s? (velem (s? ',' s? velem / s velem)*)? s? ']'
velem      <- s_unary2 / s_paren / Str / Num / s_ref
s_unary2   <- [+\-] (Num / s_ref)

# §6.1: decreasing precedence: unary, `**` (right), `* /`, `+ -`,
# relational, equality, `&&`, `||`, `?:` (UG p.87).
expr       <- Expr
Expr       <- s_ternary
s_ternary  <- s_or (s? '?' s? s_ternary s? ':' s? s_ternary)?
s_or       <- s_and (s? '||' s? s_and)*
s_and      <- s_eq (s? '&&' s? s_eq)*
s_eq       <- s_rel (s? ('==' / '!=') s? s_rel)*
s_rel      <- s_add (s? ('<=' / '>=' / '<' !'<' / '>' !'>') s? s_add)*
s_add      <- s_mul (s? [+\-] s? s_mul)*
s_mul      <- s_pow (s? ('*' !'*' / '/' / '%') s? s_pow)*
s_pow      <- s_unary (s? '**' s? s_pow)?
s_unary    <- [+\-!] !'=' s? s_unary / s_primary
s_primary  <- s_paren / Str / s_call / Num / s_ref
s_paren    <- '(' s? s_ternary s? ')'
s_call     <- s_ref s? '(' s? (s_ternary (s? ',' s? s_ternary)*)? s? ')'
s_ref      <- Name ('.' Name)*

# §2.4: a number with an exponent or an SI scale factor, then letters as a
# unit (`1pf`, `50_Ohms`); case-sensitive (`M` mega, `m` milli).
Num        <- Mag (scale [a-zA-Z_]*)? !wchar
Mag        <- mantissa ([eE] [+\-]? [0-9]+)?
mantissa   <- [0-9]+ ('.' [0-9]*)? / '.' [0-9]+
scale      <- Peta / Tera / Giga / Meg / Kilo / Unit / Centi / Milli / Micro / Nano / Pico / Femto / Atto
Peta       <- 'P'
Tera       <- 'T'
Giga       <- 'G'
Meg        <- 'M'
Kilo       <- [Kk]
Unit       <- '_'
Centi      <- [%c]
Milli      <- 'm'
Micro      <- 'u'
Nano       <- 'n'
Pico       <- 'p'
Femto      <- 'f'
Atto       <- 'a'

# §2.2: names start with a letter or `_`, then letters, digits, `_`, `!`; a
# backslash escapes any byte (`\2N2222`); a node may be an integer (`007`),
# and `.` joins a hierarchical node (`X1.n3`).
Name       <- (namestart / escaped) (wchar / escaped)*
namestart  <- [a-zA-Z_$]
escaped    <- '\\' [\x21-\x7e]
wchar      <- [a-zA-Z0-9_!$]
node       <- (Name / [0-9]+) ('.' (Name / [0-9]+))*
Node       <- node
Key        <- Name
Word       <- Name
Str     <- '"' ('\\' . / !'"' !nl .)* '"'
s          <- [ \t]+
rest       <- (!nl .)*
nl         <- '\n'
