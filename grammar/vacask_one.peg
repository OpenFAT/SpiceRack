# SpiceRack's entry over vacask.peg: one logical line at a time
# (src/import_vacask.rs), so a statement the grammar refuses stays a raw line
# and the rest of the deck still reads. Blocks (subckt ... ends, control ...
# endc) are split into their opener, body lines and closer, which the
# importer pairs.
OneLine     <- (VSubcktHead / Ends / VControl / VEndc / VAnalysis / Sweep / Include / Load / Embed
              / Global / Ground / Parameters / Model / Save / Instance / Control) nl !.
VSubcktHead <- 'subckt' !nc s? Name s? '(' s? (Node (s? Node)*)? s? ')'
VControl    <- 'control' !nc
VEndc       <- 'endc' !nc
VAnalysis   <- 'analysis' !nc s? Name s Kind (s? plist)?
