* A PDK-like model file, hand-written for tests/test_sections.rs: two
* corners, each a `.lib` section holding parameters, a shared include, a
* call of another library's section, a binned BSIM4 NMOS and its wrapper.
* HSPICE syntax, which ngspice and Xyce read too.
.lib tt
.param vth0n=0.45 u0n=0.03
.include 'shared.spice'
.lib 'res.lib' res_tt
.model nch.1 nmos level=54 version=4.5 lmin=1e-7 lmax=1e-6 wmin=1e-7 wmax=1e-4 vth0='vth0n' u0='u0n' toxe='toxe_shared'
.model nch.2 nmos level=54 version=4.5 lmin=1e-6 lmax=1e-4 wmin=1e-7 wmax=1e-4 vth0='vth0n+0.01' u0='u0n' toxe='toxe_shared'
.subckt nch_lvt d g s b w=1u l=100n
M0 d g s b nch w='w' l='l'
.ends nch_lvt
.endl tt

.lib ff
.param vth0n=0.40 u0n=0.035
.include 'shared.spice'
.lib 'res.lib' res_ff
.model nch.1 nmos level=54 version=4.5 lmin=1e-7 lmax=1e-6 wmin=1e-7 wmax=1e-4 vth0='vth0n' u0='u0n' toxe='toxe_shared'
.model nch.2 nmos level=54 version=4.5 lmin=1e-6 lmax=1e-4 wmin=1e-7 wmax=1e-4 vth0='vth0n+0.01' u0='u0n' toxe='toxe_shared'
.subckt nch_lvt d g s b w=1u l=100n
M0 d g s b nch w='w' l='l'
.ends nch_lvt
.endl ff
