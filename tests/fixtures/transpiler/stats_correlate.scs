// A made-up Spectre statistics table (Spectre Reference 19.1 p.179,
// `correlate param=[...] cc=`): a 2x2 correlate of gauss process
// parameters with a numeric cc, which SPICE writes as independent unit
// draws mixed by the correlation matrix's Cholesky factor; one parameter
// with percent, a third left uncorrelated, and truncate in process.
simulator lang=spectre
parameters a=1 b=2 c=3
statistics {
  process {
    vary a dist=gauss std=0.1
    vary b dist=gauss std=0.2 percent=yes
    vary c dist=gauss std=0.3
    truncate tr=4
  }
  correlate param=[a b] cc=0.6
}
r1 (x 0) resistor r=a+b+c
i1 (0 x) isource dc=1m
op1 dc
